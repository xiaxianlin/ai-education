{
  "name": "@ai-education/shared-types",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "watch": "tsc --watch",
    "generate:api-types": "openapi-typescript http://localhost:7890/openapi.json -o src/api/index.ts"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "openapi-typescript": "^6.7.0"
  }
}

