###############################################################################
# 前端部署配置文件
# 说明: 复制此文件为 .deploy.conf 并根据实际情况修改
###############################################################################

# SSH 服务器配置
SSH_HOST="your.server.com"          # 服务器地址或IP
SSH_PORT="22"                       # SSH 端口，默认 22
SSH_USER="deploy"                   # SSH 登录用户名
SSH_KEY="~/.ssh/id_rsa"            # SSH 私钥路径，留空则使用密码登录

# 远程部署路径
REMOTE_PATH="/var/www/html"         # 服务器上的部署目录

# 备份配置
BACKUP_ENABLED="true"               # 是否备份旧版本，true/false
BACKUP_COUNT="5"                    # 保留的备份数量

# 可选：部署后执行的命令
# POST_DEPLOY_CMD="sudo systemctl reload nginx"

###############################################################################
# 配置示例
###############################################################################

# 示例 1: 使用密钥登录
# SSH_HOST="47.96.105.206"
# SSH_PORT="22"
# SSH_USER="root"
# SSH_KEY="~/.ssh/id_rsa"
# REMOTE_PATH="/data/www"

# 示例 2: 使用密码登录
# SSH_HOST="192.168.1.100"
# SSH_PORT="22"
# SSH_USER="deploy"
# SSH_KEY=""                         # 留空使用密码
# REMOTE_PATH="/home/deploy/www"

# 示例 3: 非标准端口
# SSH_HOST="server.example.com"
# SSH_PORT="2222"
# SSH_USER="admin"
# SSH_KEY="~/.ssh/deploy_key"
# REMOTE_PATH="/opt/webapp"
