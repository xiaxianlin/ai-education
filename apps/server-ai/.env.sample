# ============================================
# AI Service 环境配置
# ============================================

# 运行环境 (development/production)
RUN_ENV=development

# 服务配置
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=7892

# ============================================
# AI 配置 (必需)
# ============================================
# AI 平台类型 (dashscope/openai 等)
AI_PLATFORM=dashscope
# AI 平台 API Key
AI_PLATFORM_KEY=your-ai-platform-key
# AI 平台 API URL
AI_PLATFORM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认文本转语音使用的声音
AI_TTS_VOICE=Jennifer

# ============================================
# 数据库配置 (必需)
# ============================================
# 数据库连接 URL
# 格式: mysql+asyncmy://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+asyncmy://aiuser:aipassword@localhost:3306/ai_helper
# 数据库连接池大小
DATABASE_POOL_SIZE=20
# 数据库连接池最大溢出数
DATABASE_MAX_OVERFLOW=10
# 数据库连接池超时时间（秒）
DATABASE_POOL_TIMEOUT=30

# ============================================
# 阿里云配置 (可选，用于 OSS 和 RAG)
# ============================================
# 阿里云 Access Key ID
ALIYUN_ACCESS_KEY_ID=
# 阿里云 Access Key Secret
ALIYUN_ACCESS_KEY_SECRET=
# OSS 端点
ALIYUN_OSS_ENDPOINT=
# OSS 存储桶名称
ALIYUN_OSS_BUCKET=
# OSS 区域
ALIYUN_OSS_REGION=
# 百炼业务空间 ID
ALIYUN_WORKSPACE_ID=
# RAG 索引 ID
ALIYUN_RAG_INDEX_ID=
# RAG 分类 ID
ALIYUN_RAG_CATEGORY_ID=

# ============================================
# 目录配置
# ============================================
# 临时文件目录
TMP_DIR=/app/tmp
# 日志目录
LOG_DIR=/app/tmp/logs
