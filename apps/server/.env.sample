# Application
RUN_ENV=development
TMP_DIR=~/projects/ai-education/tmp
LOG_DIR=~/projects/ai-education/logs
APP_SECRET_KEY=please-change-this-key
CORS_ORIGINS=*

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Alibaba Cloud
ALIYUN_ACCESS_KEY_ID=your-aliyun-ak
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-sk
ALIYUN_OSS_ENDPOINT=oss-your-endpoint
ALIYUN_OSS_BUCKET=your-bucket
ALIYUN_OSS_REGION=your-region
ALIYUN_WORKSPACE_ID=your-workspace-id
ALIYUN_RAG_INDEX_ID=your-rag-index-id
ALIYUN_RAG_CATEGORY_ID=your-rag-category-id

# Database
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ai_education
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Tasks
TASK_QUEUE_NAME=ai-education-task
TASK_TIMEOUT=1800
TASK_CONCURRENCY=2
TASK_LOGLEVEL=info

# 文本模型配置
LLM_API_KEY=sk-XXX
LLM_API_BASE=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL_NAME=doubao-seed-1-8-251228

# 图片模型配置
IMAGE_API_KEY=sk-XXX
IMAGE_API_BASE=https://api.minimaxi.com/v1/image_generation
IMAGE_MODEL_NAME=image-01

# TTS 模型配置
TTS_API_KEY=sk-XX
TTS_API_BASE=https://api.minimaxi.com/v1/t2a_v2
TTS_MODEL_NAME=speech-2.6-hd
TTS_API_VOICE=SSS

# ASR 模型配置
ASR_API_KEY=sk-XX
ASR_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_MODEL_NAME=qwen3-asr-flash
