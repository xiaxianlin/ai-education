# Application
RUN_ENV=development
TMP_DIR=./tmp
LOG_DIR=./tmp/logs
APP_SECRET_KEY=please-change-this-key

# Alibaba Cloud
ALIYUN_ACCESS_KEY_ID=your-aliyun-ak
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-sk
ALIYUN_OSS_ENDPOINT=oss-your-endpoint
ALIYUN_OSS_BUCKET=your-bucket
ALIYUN_OSS_REGION=your-region
ALIYUN_WORKSPACE_ID=your-workspace-id
ALIYUN_RAG_INDEX_ID=your-rag-index-id
ALIYUN_RAG_CATEGORY_ID=your-rag-category-id

# Database
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ai_education
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGINS=*

# AI
AI_PLATFORM=aliyun
AI_PLATFORM_KEY=your-ai-platform-key
AI_PLATFORM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_TTS_VOICE=Cherry

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Tasks
TASK_TIMEOUT=300
TASK_QUEUE_NAME=ai-education-task
